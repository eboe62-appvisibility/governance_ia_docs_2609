# === Entornos virtuales Python ===
src/log_ingestor/venv/
**/venv/
*.pyc
__pycache__/

# === Logs ===
*.log
/var/log/*
resources/logs/*.log
resources/logs/*.txt

# === Archivos temporales / swap ===
*.swp
*.swo
*~
.DS_Store

# === Docker ===
*.pid
*.sock
.env
.env.*
docker-compose.override.yml

# Permitir templates necesarios para CI
!.env.template
!**/.env.template

# === Otros ===
/*.bak
*.tmp

# === Understand-Anything (must be versioned independently) ===
Understand-Anything/

# === Documentation working copies ===
* copy*

# === Backups de base de datos ===
/backups/
/backups_old/
*.backup
*.bak
*.dump
*.sql

# === Certificados ===
*.pem
*.key
*.p12
*.crt

# === Documentation Podcast, Slides, etc ===
*.m4a
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt

# === Ficheros marcados para borrar ===
*_BORRAR*

# === Documentos de trabajo locales de cada proyecto (no versionados) ===
# Este repositorio se monta como docs/ en cada proyecto (ADR-0035): las rutas
# son relativas a su raíz, sin prefijo docs/.
# StatusQuo: logs del servidor (IPs, direcciones de correo). Plan de acción: registro de trabajo.
Project_Implementation/**/*StatusQuo*
Project_Implementation/**/*planaccion*
Project_ADRs/
Project_Corrections/

# === Understand-Anything: datos temporales y de procesamiento local ===
arquitectura/*/.ua/intermediate/
arquitectura/*/.ua/tmp/
arquitectura/*/.ua/diff-overlay.json
arquitectura/*/.ua/.trash-*/
